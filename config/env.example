# Copy this file to .env and fill the keys you want to enable.
# .env is read by server/env_loader.py at daemon/api startup.

# Optional: real YouTube Data API search (RSS feeds work without a key)
# YOUTUBE_API_KEY=AIza...

# Optional: answers for the ChatGPT mode (long-press on the handset)
# OPENAI_API_KEY=sk-...

# Optional: protect the FastAPI endpoints with a shared token
# MOOD_TOKEN=please-change-me

# Optional: custom ports (defaults: 9222 / 8642)
# MOOD_CDP_PORT=9222
# MOOD_PAGE_PORT=8642
